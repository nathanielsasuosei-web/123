# Copy to .env.local (local development) or paste into your host's environment settings.
# Everything is optional to start: with no variables set the app runs on an embedded
# Postgres with the demo catalogue, simulated checkout and emails captured to the outbox.

# ── Site ────────────────────────────────────────────────────────────────────────────
SITE_NAME=12
# Absolute URL used in emails and for the Paystack callback. On Vercel this can be left
# out — the deployment URL and request host are used instead.
SITE_URL=https://yourdomain.com

# ── Database ────────────────────────────────────────────────────────────────────────
# Any Postgres: Neon, Supabase, Vercel Postgres, RDS… Required for real accounts,
# orders and uploads. Locally, leave it out to use the embedded Postgres.
DATABASE_URL=

# ── Sessions ────────────────────────────────────────────────────────────────────────
# Signs the login cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# ── Payments (Paystack: mobile money, bank, card) ───────────────────────────────────
# Leave empty to keep the built-in test checkout.
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=GHS
PAYMENT_CHANNELS=mobile_money,bank
# Webhook URL to set in the Paystack dashboard:
#   https://yourdomain.com/api/payments/webhook

# ── Email ───────────────────────────────────────────────────────────────────────────
# With RESEND_API_KEY set, receipts and files are emailed to buyers. Without it every
# message is captured in Admin → Outbox instead.
RESEND_API_KEY=
MAIL_FROM=12 Beats <hello@yourdomain.com>
# Where "new sale" notifications go.
PRODUCER_EMAIL=
# Beats smaller than this are attached to the receipt email; larger ones get a link.
EMAIL_ATTACH_MAX_BYTES=15728640

# ── Uploads ─────────────────────────────────────────────────────────────────────────
# Vercel Blob token (Project → Storage → Blob). Required on Vercel so that uploaded
# beats and cover art persist. Without it you can still paste hosted media URLs.
BLOB_READ_WRITE_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────────────
# Set to 0 to start with an empty catalogue instead of the demo beats.
SEED_DEMO=1
