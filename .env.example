# Copy to .env, or set these in your host's environment settings.
# With no keys set, checkout runs in TEST mode and emails are kept in the producer's Mailbox.

SITE_NAME=Beat Store
# Public address of the site (used in emails and the payment callback).
SITE_URL=http://localhost:4000
PORT=4000

# Signs login sessions. Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Producer (admin) account, created on first start.
ADMIN_EMAIL=producer@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Producer

# Database and uploaded files. Point this at a persistent disk in production.
DATA_DIR=./data

# Paystack (Mobile Money + bank transfer, GHS). Leave empty for test mode.
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=GHS

# SMTP email. Leave SMTP_HOST empty to only keep emails in the Mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Beat Store <hello@example.com>
# Beats up to this size (MB) are attached to the purchase email; larger ones get a link.
EMAIL_ATTACH_MAX_MB=10

# Shown to buyers at checkout (test mode and manual bank transfers).
MOMO_NUMBER=0240000000
MOMO_NAME=Producer Name
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Producer Name
BANK_ACCOUNT_NUMBER=0000000000
