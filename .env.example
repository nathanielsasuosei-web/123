# Copy to .env (or set these in your host's environment settings). Everything is optional
# for local testing: with no keys set, checkout runs in TEST mode and emails go to the Outbox.

SITE_NAME=Beat Store
# Public address of the site, used in email links and the Paystack callback.
SITE_URL=http://localhost:4000
PORT=4000

# Secret used to sign login sessions. Use a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Admin (producer) account, created on first start.
ADMIN_EMAIL=producer@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Producer

# Where uploaded files and the database live. Use a persistent disk in production.
DATA_DIR=./data

# ── Payments (Paystack: Mobile Money + bank transfer, GHS) ─────────────────────────
# Leave empty for TEST mode (simulated Mobile Money / bank payment).
PAYSTACK_SECRET_KEY=
PAYMENT_CURRENCY=GHS
# Webhook URL to paste in the Paystack dashboard: {SITE_URL}/api/payments/webhook

# ── Email (SMTP). Leave SMTP_HOST empty to only record emails in the Outbox ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Beat Store <hello@example.com>
# Beats up to this size (MB) are attached to the purchase email; larger ones get a link only.
EMAIL_ATTACH_MAX_MB=10

# ── Producer details shown at checkout (test mode / manual bank transfer) ─────────
MOMO_NUMBER=0240000000
MOMO_NAME=Producer Name
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Producer Name
BANK_ACCOUNT_NUMBER=0000000000
