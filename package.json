{
  "name": "producer-beat-store",
  "version": "1.0.0",
  "private": true,
  "description": "A beat & video store for a music producer: artist accounts, Mobile Money and bank payments (Paystack), beat delivery and messages by email.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16"
  }
}
