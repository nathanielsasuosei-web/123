{
  "name": "producer-beat-store",
  "version": "1.0.0",
  "private": true,
  "description": "Beat and video store for a music producer: artist accounts, Mobile Money and bank payments, delivery and messages by email.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/seed.js",
    "smoke": "node scripts/smoke.js",
    "check:ui": "node scripts/frontend-check.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
