# Server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:5173

# Admin account created by the seed script (server/seed.js)
ADMIN_EMAIL=admin@mirakilousbeats.com
ADMIN_PASSWORD=admin123

# SMTP — when set, emails are really sent. When empty, emails are stored in
# the "Mailbox" tab of the admin dashboard (demo mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MiraKilousE Beats <no-reply@mirakilousbeats.com>

# Set PAYMENT_AUTO_CONFIRM=0 to require the admin to confirm payments manually.
PAYMENT_AUTO_CONFIRM=1
