{
  "name": "12-beats",
  "version": "1.0.0",
  "private": true,
  "description": "12 — beat & video store. Next.js storefront with Paystack (mobile money + bank) checkout, email delivery and a producer admin.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/db-init.mjs",
    "producer:create": "node scripts/create-producer.mjs",
    "smoke": "node scripts/smoke.mjs",
    "media:demo": "python3 scripts/generate-demo-media.py"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@vercel/blob": "^2.8.1",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
